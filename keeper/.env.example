# localnet | devnet
CLUSTER=devnet
# Optional RPC override (defaults to the deployment's rpcUrl)
RPC_URL=
# Keeper keypair as a JSON byte array; defaults to ../wallets/keeper.keypair.json
KEEPER_KEYPAIR=
# Optional: NAV history store read by the web app
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
